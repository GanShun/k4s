#!/bin/bash
#
# DIT - build the k4s initramfs.
#
# Fetches each component over HTTPS from its upstream default branch, tidies it,
# and assembles a single BusyBox-style initramfs with gobusybox.
#
# Two deliberate changes from the original script:
#
#   * HTTPS instead of SSH. These repositories are public, so no key material
#     is needed: the build runs on a clean host or CI runner, and nothing
#     secret can leak into the log or into a checkout's .git/config. runc is
#     not fetched here at all: it is the sibling checkout ../runc, which the
#     build requires and never clones.
#
#   * Branches instead of exact revisions. Each component is named by its
#     upstream default branch, so nothing here is invalidated by a rebase or by
#     a branch moving. That trades reproducibility for maintainability: a fresh
#     host gets whatever the branch points at today, and the revision actually
#     built is printed for every component. An existing checkout is used
#     exactly as it stands, local modifications included.
#
# go.work is committed and is NOT regenerated here: it already lists every
# module below, and it carries the dependency pin the build relies on. Note
# that `go work init` refuses to overwrite an existing workspace, so the old
# `go work init u-root` line was a silent no-op and has been removed.

set -euxo pipefail

# DIT is run as ./DIT from the repository root. Record that root once: runc is
# a sibling checkout (../runc), so a subshell that cds into it can no longer
# reach build/ by a relative path.
REPO_ROOT=$(pwd)

# --- component branches -------------------------------------------------------
UROOT_REPO=https://github.com/u-root/u-root.git
UROOT_REF=main

CONTAINERD_REPO=https://github.com/containerd/containerd.git
CONTAINERD_REF=main

COREDNS_REPO=https://github.com/coredns/coredns.git
COREDNS_REF=master

ETCD_REPO=https://github.com/etcd-io/etcd.git
ETCD_REF=main

# The one component not on its upstream default branch, and a deliberate
# exception: flannel's `master` cannot build CGO_ENABLED=0. Its
# pkg/backend/udp/cproxy_amd64.go imports "C", and the pure-Go replacement
# (proxy.go, `//go:build !cgo`) lives only on this branch. A CGO_ENABLED=0
# build of `master` fails with
#   undefined: runCProxy, stopProxy, setRoute, removeRoute
FLANNEL_REPO=https://github.com/u-root/flannel.git
FLANNEL_REF=purego

# runc is the one component this project has a fork of and develops, and it is a
# *sibling repository* rather than a directory in this one: it is built from
# ../runc as it stands rather than being reset to a revision, because a local
# branch, or an uncommitted change, is exactly what you want to test. There is
# no clone fallback: a fallback could only fetch a runc that cannot run
# container hooks, so a missing checkout is a hard error at the fetch step.
#
# The sibling checkout. Deliberately outside this repository: it is a separate
# repository with its own branches and remotes, and `go.work` names it as
# `../runc` too.
RUNC_DIR=../runc

KUBERNETES_REPO=https://github.com/kubernetes/kubernetes.git
KUBERNETES_REF=master

CNI_REPO=https://github.com/containernetworking/plugins.git
CNI_REF=main

# flanneld is only half of flannel. The CNI half is a separate repository: a
# meta-plugin that reads the subnet flanneld allocated out of
# /run/flannel/subnet.env and invokes bridge and host-local with it.
FLANNEL_CNI_REPO=https://github.com/flannel-io/cni-plugin.git
FLANNEL_CNI_REF=main

# --- fetch ------------------------------------------------------------------
# Fetch <ref> into <dir>, or reuse an existing checkout exactly as it stands.
# Nothing is fetched or reset into an existing checkout: a local branch, or an
# uncommitted change, is exactly what you want to test, and clobbering it is
# never acceptable. The revision that goes into the image is printed for every
# component, and that report is what replaces the old pin.
clone_pinned() {
    local dir=$1 repo=$2 ref=$3
    if [ -d "$dir/.git" ]; then
        : # reuse the checkout as it stands
    elif [ -e "$dir" ]; then
        echo "error: $dir exists and is not a git checkout" >&2
        exit 1
    else
        git clone -q --depth 1 --branch "$ref" "$repo" "$dir"
    fi
    echo "  $dir $(git -C "$dir" rev-parse --short HEAD) ($(git -C "$dir" rev-parse --abbrev-ref HEAD), $(git -C "$dir" status --porcelain | wc -l) modified)"
}

echo "Fetching component branches"
clone_pinned u-root     "$UROOT_REPO"     "$UROOT_REF"
clone_pinned containerd "$CONTAINERD_REPO" "$CONTAINERD_REF"
clone_pinned coredns    "$COREDNS_REPO"    "$COREDNS_REF"
clone_pinned etcd       "$ETCD_REPO"       "$ETCD_REF"
clone_pinned flannel    "$FLANNEL_REPO"    "$FLANNEL_REF"
clone_pinned kubernetes "$KUBERNETES_REPO" "$KUBERNETES_REF"
clone_pinned cni-plugins "$CNI_REPO" "$CNI_REF"
clone_pinned flannel-cni-plugin "$FLANNEL_CNI_REPO" "$FLANNEL_CNI_REF"

if [ ! -d "$RUNC_DIR/.git" ]; then
	echo "error: no runc checkout at $RUNC_DIR" >&2
	echo "       the sibling repository is required: it is the cgo-free fork" >&2
	echo "       this image needs, and the build never clones it." >&2
	exit 1
fi
echo "runc: building $(git -C "$RUNC_DIR" rev-parse --short HEAD)" \
	"($(git -C "$RUNC_DIR" rev-parse --abbrev-ref HEAD)," \
	"$(git -C "$RUNC_DIR" status --porcelain | wc -l) modified files)"

# --- tidy -------------------------------------------------------------------
(cd containerd && go mod tidy)
(cd coredns && go mod tidy)
(cd etcd/etcdctl && go mod tidy)
(cd flannel && go mod tidy)
(cd u-root && go mod tidy && env -u GOARCH -u GOOS go build)

# Two components cannot be folded into the bb busybox because they re-exec
# /proc/self/exe (or os.Executable()): under a multiplexer that resolves to the
# bb binary itself, and bb dispatches on argv[0], so the child cannot find its
# applet and dies.
#   * containerd-shim-runc-v2 spawns its long-running daemon that way
#   * runc spawns the container init that way (exec.Command(exePath, "init"))
# Both are built as standalone binaries and added with -files.
#
# runc comes from a fork whose !cgo path does both cgo-only jobs in Go: it
# creates the container namespaces with clone(2) instead of the C nsexec
# constructor, and it compiles seccomp profiles to BPF instead of calling
# libseccomp. So it builds with CGO_ENABLED=0 and still enforces seccomp. See
# ../runc/docs/nsenter-and-runc.md. User namespaces still need the staged unshare that
# nsexec implements, and are not handled.
mkdir -p build
(cd containerd && CGO_ENABLED=0 env -u GOARCH -u GOOS go build \
	-o ../build/containerd-shim-runc-v2 ./cmd/containerd-shim-runc-v2)
(cd "$RUNC_DIR" && CGO_ENABLED=0 env -u GOARCH -u GOOS go build -o "$REPO_ROOT/build/runc" .)
# kubelet is pure Go, but it is one large binary rather than a bb applet.
# The version stamp keeps the apiserver skew check happy.
(cd kubernetes && CGO_ENABLED=0 env -u GOARCH -u GOOS go build -mod=vendor \
	-ldflags "-s -w -X k8s.io/component-base/version.gitVersion=v1.35.8" \
	-o ../build/kubelet ./cmd/kubelet)
# The node's own bring-up, cmd/uinit, is a bb applet rather than a -files binary.
# It does not re-exec itself, so the applet-name problem that keeps runc and the
# shim standalone does not apply to it, and it is a go.work member so that
# u-root's single build can compile it. See the assemble list below.
#
# The CNI plugin set.
#
# loopback is required whichever CNI is chosen: the CRI synthesises a loopback
# network of its own and invokes /opt/cni/bin/loopback for it.
#
# flannel is a meta-plugin. It reads the subnet flanneld allocated out of
# /run/flannel/subnet.env and delegates the real work to bridge and host-local,
# so all three have to be present for a pod to get an address.
#
# flannel is the default CNI, with Cilium evaluated in docs/cilium.md and run by
# the same harness under K4S_CNI=cilium. flannel is here because it needs nothing
# from the kernel that this one lacks.
(cd cni-plugins && GOWORK=off CGO_ENABLED=0 env -u GOARCH -u GOOS \
	go build -o ../build/loopback ./plugins/main/loopback)
(cd cni-plugins && GOWORK=off CGO_ENABLED=0 env -u GOARCH -u GOOS \
	go build -o ../build/bridge ./plugins/main/bridge)
(cd cni-plugins && GOWORK=off CGO_ENABLED=0 env -u GOARCH -u GOOS \
	go build -o ../build/host-local ./plugins/ipam/host-local)
(cd flannel-cni-plugin && GOWORK=off CGO_ENABLED=0 env -u GOARCH -u GOOS \
	go build -o ../build/cni-flannel .)

# --- assemble ---------------------------------------------------------------
# Node configuration that is not a secret. The kubelet kubeconfig is NOT here:
# it is issued by the cluster and spliced in by scripts/test-cluster.sh.
# The CA bundle is required for HTTPS image pulls; u-root ships no trust store.
CA_BUNDLE=${CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}
# u-root/cmds/core/* is the base applet set. The rest are separate projects that
# are go.work members, which is what lets this one build compile them: u-root
# makes one binary and dispatches on argv[0], and a package outside the workspace
# cannot take part in that build. ./cmd/uinit is the node's bring-up, and u-root's
# init runs it from /bbin/uinit. It reads its role from /etc/k4s/role, which is
# installed just above -- the two roles have to be one package because u-root
# builds bb with GO111MODULE=off and links only the packages named here, so an
# applet cannot import a sibling package. runc exec's namespace staging is not
# here: it is a subcommand of the runc binary itself (../runc/libcontainer/
# runcns_linux.go), so there is no second helper to package.
./u-root/u-root -o initramfs.cpio \
	-files build/containerd-shim-runc-v2:bin/containerd-shim-runc-v2 \
	-files build/runc:bin/runc \
	-files build/kubelet:bin/kubelet \
	-files "$CA_BUNDLE":etc/ssl/certs/ca-certificates.crt \
	-files configs/node/kubelet.yaml:etc/kubernetes/kubelet.yaml \
	-files configs/node/role:etc/k4s/role \
	-files configs/node/passwd:etc/passwd \
	-files configs/node/group:etc/group \
	-files configs/node/hosts:etc/hosts \
	-files build/loopback:opt/cni/bin/loopback \
	-files build/bridge:opt/cni/bin/bridge \
	-files build/host-local:opt/cni/bin/host-local \
	-files build/cni-flannel:opt/cni/bin/flannel \
	-files configs/node/10-flannel.conflist:etc/cni/net.d/10-flannel.conflist \
	-files configs/node/flannel-net-conf.json:etc/kube-flannel/net-conf.json \
	u-root/cmds/core/* \
	./containerd/cmd/containerd \
	./containerd/cmd/ctr \
	./flannel \
	./coredns \
	./etcd/etcdctl \
	./cmd/uinit
