# k4s minimal kernel configuration.
#
# Applied on top of `make tinyconfig` (see the Makefile). This is the smallest
# set we have needed to boot the u-root image and run a container runtime.
# Grouped by what pulls each option in, so removals are easy to reason about.
#
# Regenerate from scratch with:  rm -rf build && make kernel

# --- platform -------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# --- power management -----------------------------------------------------
# ACPI poweroff so the guest can stop QEMU instead of halting.
CONFIG_ACPI=y

# --- executable formats ---------------------------------------------------
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y

# --- block layer / initramfs ----------------------------------------------
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y

# --- console / tty --------------------------------------------------------
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# --- pseudo filesystems ---------------------------------------------------
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# --- syscalls the Go runtime, runc and containerd rely on ------------------
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_AIO=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y

# --- namespaces and cgroups ----------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y

# --- security primitives --------------------------------------------------
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- filesystems ----------------------------------------------------------
CONFIG_OVERLAY_FS=y

# --- networking -----------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_DUMMY=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_IPTABLES=y

# --- virtio (QEMU) --------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- 9p host share (development convenience) ------------------------------
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# --- eBPF (needed by Cilium later) ---------------------------------------
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y

# --- diagnostics ----------------------------------------------------------
CONFIG_KALLSYMS=y
